# ==============================================================================
# Damak Municipality - Intern Management System (IMS)
# Environment Variables Template (.env.example)
# Copy this file to .env and configure your local settings
# ==============================================================================

# Django Secret Key (generate a strong random key for production)
SECRET_KEY=change-me-to-a-secure-random-secret-key

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated domain names or IP addresses)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL recommended for production, sqlite for local development)
DB_ENGINE=mysql
DB_NAME=damak_ims
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
